{
  "name": "ck-cli",
  "version": "0.0.0",
  "description": "Parse Amazon Kindle clippings and sync to ClippingKK service",
  "bin": {
    "ck-cli": "./ck-cli"
  },
  "type": "module",
  "module": "src/main.tsx",
  "scripts": {
    "dev": "bun run src/main.tsx",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "react-devtools-core": "^7.0.1",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^18.3.27",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
