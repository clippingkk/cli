{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn",
    "no-await-in-loop": "off",
    "unicorn/prefer-set-has": "off"
  },
  "ignorePatterns": ["node_modules", "dist", "tests/fixtures"]
}
